(kicad_pcb
  (version 20230121)
  (generator pcbnew)
  (general
    (thickness 1.6)
  )
  (paper "A3")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (44 "Edge.Cuts" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user "B.Fabrication")
    (49 "F.Fab" user "F.Fabrication")
  )
  (setup
    (pad_to_mask_clearance 0)
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (outputdirectory "gerbers/")
      (usegerberextensions false)
      (usegerberattributes true)
      (usegerberadvancedattributes true)
      (creategerberjobfile true)
      (svgprecision 6)
      (excludeedgelayer true)
      (plotreference true)
      (plotvalue true)
      (plotinvisibletext false)
      (outputformat 1)
      (mirror false)
      (drillshape 1)
      (scaleselection 1)
    )
  )

  (net 0 "")
  (net 1 "VCC_3V3")
  (net 2 "GND")
  (net 3 "I2C_SDA")
  (net 4 "I2C_SCL")
  (net 5 "IR_OUT")
  (net 6 "RAIN_DO")
  (net 7 "RAIN_AO")
  (net 8 "ADXL_INT1")
  (net 9 "XSHUT")
  (net 10 "BUZZER_OUT")

  ;; ─────────────────────────────────────────────
  ;; U1 - ESP32 NodeMCU-32S  (center: 80, 60)
  ;; Left col X=67.3  Right col X=92.7
  ;; Y offsets: -22.86 to +22.86 step 2.54
  ;; ─────────────────────────────────────────────
  (footprint "ESP32:NodeMCU-32S" (layer "F.Cu") (at 80 60)
    (descr "ESP32 NodeMCU 38-pin Development Board")
    (property "Reference" "U1" (at 0 -28) (layer "F.SilkS")
      (effects (font (size 1.5 1.5) (thickness 0.2)))
    )
    (property "Value" "NodeMCU-32S" (at 0 28) (layer "F.Fab")
      (effects (font (size 1.5 1.5) (thickness 0.2)))
    )
    (fp_rect (start -14.5 -25.5) (end 14.5 25.5) (layer "F.CrtYd") (width 0.05))
    (fp_rect (start -13 -24) (end 13 24) (layer "F.Fab") (width 0.1))
    (fp_text user "ESP32-WROOM-32D" (at 0 0) (layer "F.Fab")
      (effects (font (size 1 1) (thickness 0.1)))
    )
    ;; Left column (L1-L19): 3V3 GND D15 D2 D4 RX2 TX2 D22 D21 D0 D1 D3 D5 D18 D19 D21 D23 GND 3V3
    (pad "L1"  thru_hole circle (at -12.7 -22.86) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 1 "VCC_3V3"))
    (pad "L2"  thru_hole circle (at -12.7 -20.32) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 2 "GND"))
    (pad "L3"  thru_hole circle (at -12.7 -17.78) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "L4"  thru_hole circle (at -12.7 -15.24) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "L5"  thru_hole circle (at -12.7 -12.7)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "L6"  thru_hole circle (at -12.7 -10.16) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "L7"  thru_hole circle (at -12.7 -7.62)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "L8"  thru_hole circle (at -12.7 -5.08)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 4 "I2C_SCL"))
    (pad "L9"  thru_hole circle (at -12.7 -2.54)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 3 "I2C_SDA"))
    (pad "L10" thru_hole circle (at -12.7  0)     (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "L11" thru_hole circle (at -12.7  2.54)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "L12" thru_hole circle (at -12.7  5.08)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "L13" thru_hole circle (at -12.7  7.62)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 9 "XSHUT"))
    (pad "L14" thru_hole circle (at -12.7 10.16)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "L15" thru_hole circle (at -12.7 12.7)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "L16" thru_hole circle (at -12.7 15.24)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "L17" thru_hole circle (at -12.7 17.78)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "L18" thru_hole circle (at -12.7 20.32)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 2 "GND"))
    (pad "L19" thru_hole circle (at -12.7 22.86)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 1 "VCC_3V3"))
    ;; Right column (R1-R19): VIN GND D13 D12 D14 D27 D26 D25 D33 D32 D35 D34 SVP SVN D36 GND 3V3 EN BOOT
    (pad "R1"  thru_hole circle (at 12.7 -22.86)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 1 "VCC_3V3"))
    (pad "R2"  thru_hole circle (at 12.7 -20.32)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 2 "GND"))
    (pad "R3"  thru_hole circle (at 12.7 -17.78)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "R4"  thru_hole circle (at 12.7 -15.24)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "R5"  thru_hole circle (at 12.7 -12.7)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "R6"  thru_hole circle (at 12.7 -10.16)  (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "R7"  thru_hole circle (at 12.7 -7.62)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 10 "BUZZER_OUT"))
    (pad "R8"  thru_hole circle (at 12.7 -5.08)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "R9"  thru_hole circle (at 12.7 -2.54)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 8 "ADXL_INT1"))
    (pad "R10" thru_hole circle (at 12.7  0)      (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "R11" thru_hole circle (at 12.7  2.54)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 6 "RAIN_DO"))
    (pad "R12" thru_hole circle (at 12.7  5.08)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 5 "IR_OUT"))
    (pad "R13" thru_hole circle (at 12.7  7.62)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "R14" thru_hole circle (at 12.7 10.16)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "R15" thru_hole circle (at 12.7 12.7)    (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 7 "RAIN_AO"))
    (pad "R16" thru_hole circle (at 12.7 15.24)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 2 "GND"))
    (pad "R17" thru_hole circle (at 12.7 17.78)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 1 "VCC_3V3"))
    (pad "R18" thru_hole circle (at 12.7 20.32)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "R19" thru_hole circle (at 12.7 22.86)   (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
  )

  ;; ─────────────────────────────────────────────
  ;; U2 - VL53L0X ToF Sensor  (center: 20, 60)
  ;; Pins: VCC GND SCL SDA XSHUT GPIO1
  ;; ─────────────────────────────────────────────
  (footprint "Sensor:VL53L0X_Module" (layer "F.Cu") (at 20 60)
    (descr "VL53L0X Time-of-Flight Sensor Module - CJVL53L0XV2")
    (property "Reference" "U2" (at 0 -12) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (property "Value" "CJVL53L0XV2" (at 0 12) (layer "F.Fab")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_rect (start -9 -10) (end 9 10) (layer "F.CrtYd") (width 0.05))
    (fp_rect (start -8 -9) (end 8 9) (layer "F.Fab") (width 0.1))
    (fp_circle (center 0 -3) (end 0 -1) (layer "F.Fab") (width 0.2))
    (fp_text user "VL53L0X" (at 0 2) (layer "F.Fab")
      (effects (font (size 0.8 0.8) (thickness 0.1)))
    )
    (pad "1" thru_hole rect   (at -6.35 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 1 "VCC_3V3"))
    (pad "2" thru_hole circle (at -3.81 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 2 "GND"))
    (pad "3" thru_hole circle (at -1.27 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 4 "I2C_SCL"))
    (pad "4" thru_hole circle (at  1.27 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 3 "I2C_SDA"))
    (pad "5" thru_hole circle (at  3.81 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 9 "XSHUT"))
    (pad "6" thru_hole circle (at  6.35 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (fp_text user "VCC GND SCL SDA XS  G1" (at 0 4) (layer "F.Fab")
      (effects (font (size 0.5 0.5) (thickness 0.08)))
    )
  )

  ;; ─────────────────────────────────────────────
  ;; U3 - IR Obstacle Sensor  (center: 80, 15)
  ;; Pins: OUT GND VCC
  ;; ─────────────────────────────────────────────
  (footprint "Sensor:IR_Module_3P" (layer "F.Cu") (at 80 15)
    (descr "IR Obstacle Sensor Module")
    (property "Reference" "U3" (at 0 -9) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (property "Value" "IR-Sensor" (at 0 9) (layer "F.Fab")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_rect (start -6 -7) (end 6 7) (layer "F.CrtYd") (width 0.05))
    (fp_rect (start -5 -6) (end 5 6) (layer "F.Fab") (width 0.1))
    (fp_circle (center 0 -2) (end 0 0) (layer "F.Fab") (width 0.3))
    (fp_text user "IR Sensor" (at 0 1) (layer "F.Fab")
      (effects (font (size 0.7 0.7) (thickness 0.1)))
    )
    (pad "1" thru_hole rect   (at -2.54 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 5 "IR_OUT"))
    (pad "2" thru_hole circle (at  0    0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 2 "GND"))
    (pad "3" thru_hole circle (at  2.54 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 1 "VCC_3V3"))
    (fp_text user "OUT GND VCC" (at 0 3.5) (layer "F.Fab")
      (effects (font (size 0.5 0.5) (thickness 0.08)))
    )
  )

  ;; ─────────────────────────────────────────────
  ;; SENS1 - Rain Sensing Pad  (center: 120, 38)
  ;; ─────────────────────────────────────────────
  (footprint "Sensor:RainPad" (layer "F.Cu") (at 120 38)
    (descr "Rain Sensing Electrode Pad")
    (property "Reference" "SENS1" (at 0 -16) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (property "Value" "Rain-Pad" (at 0 16) (layer "F.Fab")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_rect (start -16 -14) (end 16 14) (layer "F.CrtYd") (width 0.05))
    (fp_rect (start -15 -13) (end 15 13) (layer "F.Fab") (width 0.15))
    ;; Interdigitated electrode pattern
    (fp_line (start -12 -10) (end -12 10) (layer "F.Fab") (width 0.4))
    (fp_line (start  -9 -10) (end  -9 10) (layer "F.Fab") (width 0.4))
    (fp_line (start  -6 -10) (end  -6 10) (layer "F.Fab") (width 0.4))
    (fp_line (start  -3 -10) (end  -3 10) (layer "F.Fab") (width 0.4))
    (fp_line (start   0 -10) (end   0 10) (layer "F.Fab") (width 0.4))
    (fp_line (start   3 -10) (end   3 10) (layer "F.Fab") (width 0.4))
    (fp_line (start   6 -10) (end   6 10) (layer "F.Fab") (width 0.4))
    (fp_line (start   9 -10) (end   9 10) (layer "F.Fab") (width 0.4))
    (fp_line (start  12 -10) (end  12 10) (layer "F.Fab") (width 0.4))
    (pad "1" thru_hole rect   (at -2.54 11) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "2" thru_hole circle (at  2.54 11) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (fp_text user "Rain Pad" (at 0 -8) (layer "F.Fab")
      (effects (font (size 1 1) (thickness 0.15)))
    )
  )

  ;; ─────────────────────────────────────────────
  ;; U4 - Rain Sensor Module LM393  (center: 140, 68)
  ;; Pins (top-to-bottom): GND VCC DO AO
  ;; ─────────────────────────────────────────────
  (footprint "Sensor:RainModule_LM393" (layer "F.Cu") (at 140 68)
    (descr "Rain Detector Module with LM393 Comparator")
    (property "Reference" "U4" (at 0 -12) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (property "Value" "Rain-LM393" (at 0 12) (layer "F.Fab")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_rect (start -8 -9) (end 8 9) (layer "F.CrtYd") (width 0.05))
    (fp_rect (start -7 -8) (end 7 8) (layer "F.Fab") (width 0.1))
    (fp_rect (start -4 -4) (end 4 2) (layer "F.Fab") (width 0.1))
    (fp_text user "LM393" (at 0 -1) (layer "F.Fab")
      (effects (font (size 0.7 0.7) (thickness 0.1)))
    )
    (pad "1" thru_hole rect   (at 0 -3.81) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 2 "GND"))
    (pad "2" thru_hole circle (at 0 -1.27) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 1 "VCC_3V3"))
    (pad "3" thru_hole circle (at 0  1.27) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 6 "RAIN_DO"))
    (pad "4" thru_hole circle (at 0  3.81) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 7 "RAIN_AO"))
    (fp_text user "GND VCC DO AO" (at 4 0) (layer "F.Fab") (angle 900)
      (effects (font (size 0.5 0.5) (thickness 0.08)))
    )
  )

  ;; ─────────────────────────────────────────────
  ;; U5 - ADXL345 Accelerometer  (center: 92, 100)
  ;; Pins: GND VCC CS INT1 INT2 SDA SCL
  ;; ─────────────────────────────────────────────
  (footprint "Sensor:ADXL345_Module" (layer "F.Cu") (at 92 100)
    (descr "ADXL345 3-Axis Digital Accelerometer Module")
    (property "Reference" "U5" (at 0 -12) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (property "Value" "ADXL345" (at 0 12) (layer "F.Fab")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_rect (start -11 -8) (end 11 8) (layer "F.CrtYd") (width 0.05))
    (fp_rect (start -10 -7) (end 10 7) (layer "F.Fab") (width 0.1))
    (fp_rect (start -5 -3) (end 5 3) (layer "F.Fab") (width 0.1))
    (fp_circle (center -4 -2) (end -3.5 -2) (layer "F.Fab") (width 0.2))
    (fp_text user "ADXL345" (at 0 0) (layer "F.Fab")
      (effects (font (size 0.8 0.8) (thickness 0.1)))
    )
    (pad "1" thru_hole rect   (at -7.62 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 2 "GND"))
    (pad "2" thru_hole circle (at -5.08 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 1 "VCC_3V3"))
    (pad "3" thru_hole circle (at -2.54 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "4" thru_hole circle (at  0    0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 8 "ADXL_INT1"))
    (pad "5" thru_hole circle (at  2.54 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 0 ""))
    (pad "6" thru_hole circle (at  5.08 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 3 "I2C_SDA"))
    (pad "7" thru_hole circle (at  7.62 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 4 "I2C_SCL"))
    (fp_text user "GND VCC CS I1 I2 SDA SCL" (at 0 4.5) (layer "F.Fab")
      (effects (font (size 0.5 0.5) (thickness 0.08)))
    )
  )

  ;; ─────────────────────────────────────────────
  ;; BZ1 - Passive Buzzer  (center: 110, 20)
  ;; ─────────────────────────────────────────────
  (footprint "Buzzer:Buzzer_12mm_Vertical" (layer "F.Cu") (at 110 20)
    (descr "5V Passive Piezo Buzzer")
    (property "Reference" "BZ1" (at 0 -9) (layer "F.SilkS")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (property "Value" "Buzzer-5V" (at 0 9) (layer "F.Fab")
      (effects (font (size 1 1) (thickness 0.15)))
    )
    (fp_circle (center 0 0) (end 0 6.5) (layer "F.CrtYd") (width 0.05))
    (fp_circle (center 0 0) (end 0 6) (layer "F.Fab") (width 0.2))
    (fp_circle (center 0 0) (end 0 2) (layer "F.Fab") (width 0.1))
    (fp_line (start -1.5 0) (end 1.5 0) (layer "F.Fab") (width 0.2))
    (fp_line (start 0 -1.5) (end 0 1.5) (layer "F.Fab") (width 0.2))
    (pad "1" thru_hole rect   (at -2.54 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 10 "BUZZER_OUT"))
    (pad "2" thru_hole circle (at  2.54 0) (size 1.7 1.7) (drill 0.9) (layers "*.Cu" "*.Mask") (net 2 "GND"))
    (fp_text user "+   -" (at 0 3.5) (layer "F.SilkS")
      (effects (font (size 0.8 0.8) (thickness 0.12)))
    )
  )

  ;; ═══════════════════════════════════════════════════════════
  ;; COPPER TRACES  (all on F.Cu)
  ;; Absolute positions = component_center + pad_offset
  ;; ESP32 center=(80,60): L_pads x=67.3, R_pads x=92.7
  ;; ═══════════════════════════════════════════════════════════

  ;; ── VCC_3V3 (net 1, width 0.5mm) ──────────────────────────
  ;; ESP32 L1 (67.3, 37.14) -> VL53L0X pad1 (13.65, 60)
  (segment (start 67.3 37.14) (end 55 37.14) (width 0.5) (layer "F.Cu") (net 1))
  (segment (start 55 37.14) (end 55 28) (width 0.5) (layer "F.Cu") (net 1))
  (segment (start 55 28) (end 13.65 28) (width 0.5) (layer "F.Cu") (net 1))
  (segment (start 13.65 28) (end 13.65 60) (width 0.5) (layer "F.Cu") (net 1))
  ;; ESP32 R1 (92.7, 37.14) -> IR pad3 (82.54, 15)
  (segment (start 92.7 37.14) (end 100 37.14) (width 0.5) (layer "F.Cu") (net 1))
  (segment (start 100 37.14) (end 100 22) (width 0.5) (layer "F.Cu") (net 1))
  (segment (start 100 22) (end 82.54 22) (width 0.5) (layer "F.Cu") (net 1))
  (segment (start 82.54 22) (end 82.54 15) (width 0.5) (layer "F.Cu") (net 1))
  ;; VCC trunk -> Rain Module pad2 (140, 66.73)
  (segment (start 100 22) (end 135 22) (width 0.5) (layer "F.Cu") (net 1))
  (segment (start 135 22) (end 135 66.73) (width 0.5) (layer "F.Cu") (net 1))
  (segment (start 135 66.73) (end 140 66.73) (width 0.5) (layer "F.Cu") (net 1))
  ;; VCC -> ADXL pad2 (86.92, 100)
  (segment (start 100 37.14) (end 107 37.14) (width 0.5) (layer "F.Cu") (net 1))
  (segment (start 107 37.14) (end 107 95) (width 0.5) (layer "F.Cu") (net 1))
  (segment (start 107 95) (end 86.92 95) (width 0.5) (layer "F.Cu") (net 1))
  (segment (start 86.92 95) (end 86.92 100) (width 0.5) (layer "F.Cu") (net 1))

  ;; ── GND (net 2, width 0.5mm) ───────────────────────────────
  ;; ESP32 L2 (67.3, 39.68) -> VL53 pad2 (16.19, 60)
  (segment (start 67.3 39.68) (end 57 39.68) (width 0.5) (layer "F.Cu") (net 2))
  (segment (start 57 39.68) (end 57 110) (width 0.5) (layer "F.Cu") (net 2))
  ;; GND bus horizontal
  (segment (start 57 110) (end 145 110) (width 0.5) (layer "F.Cu") (net 2))
  ;; GND -> VL53 pad2 (16.19, 60)
  (segment (start 57 110) (end 16.19 110) (width 0.5) (layer "F.Cu") (net 2))
  (segment (start 16.19 110) (end 16.19 60) (width 0.5) (layer "F.Cu") (net 2))
  ;; GND -> IR pad2 (80, 15) via top edge
  (segment (start 67.3 39.68) (end 67.3 35) (width 0.5) (layer "F.Cu") (net 2))
  (segment (start 67.3 35) (end 60 35) (width 0.5) (layer "F.Cu") (net 2))
  (segment (start 60 35) (end 60 8) (width 0.5) (layer "F.Cu") (net 2))
  (segment (start 60 8) (end 80 8) (width 0.5) (layer "F.Cu") (net 2))
  (segment (start 80 8) (end 80 15) (width 0.5) (layer "F.Cu") (net 2))
  ;; GND -> BZ1 pad2 (112.54, 20)
  (segment (start 112.54 20) (end 112.54 8) (width 0.5) (layer "F.Cu") (net 2))
  (segment (start 112.54 8) (end 60 8) (width 0.5) (layer "F.Cu") (net 2))
  ;; GND -> Rain Module pad1 (140, 64.19)
  (segment (start 145 110) (end 145 64.19) (width 0.5) (layer "F.Cu") (net 2))
  (segment (start 145 64.19) (end 140 64.19) (width 0.5) (layer "F.Cu") (net 2))
  ;; GND -> ADXL pad1 (84.38, 100)
  (segment (start 57 110) (end 84.38 110) (width 0.5) (layer "F.Cu") (net 2))
  (segment (start 84.38 110) (end 84.38 100) (width 0.5) (layer "F.Cu") (net 2))

  ;; ── I2C_SDA (net 3, width 0.25mm) ─────────────────────────
  ;; ESP32 L9 (67.3, 57.46) -> VL53 pad4 (21.27, 60)
  (segment (start 67.3 57.46) (end 41 57.46) (width 0.25) (layer "F.Cu") (net 3))
  (segment (start 41 57.46) (end 41 63) (width 0.25) (layer "F.Cu") (net 3))
  (segment (start 41 63) (end 21.27 63) (width 0.25) (layer "F.Cu") (net 3))
  (segment (start 21.27 63) (end 21.27 60) (width 0.25) (layer "F.Cu") (net 3))
  ;; SDA shared -> ADXL pad6 (97.08, 100)
  (segment (start 41 57.46) (end 41 80) (width 0.25) (layer "F.Cu") (net 3))
  (segment (start 41 80) (end 97.08 80) (width 0.25) (layer "F.Cu") (net 3))
  (segment (start 97.08 80) (end 97.08 100) (width 0.25) (layer "F.Cu") (net 3))

  ;; ── I2C_SCL (net 4, width 0.25mm) ─────────────────────────
  ;; ESP32 L8 (67.3, 54.92) -> VL53 pad3 (18.73, 60)
  (segment (start 67.3 54.92) (end 43 54.92) (width 0.25) (layer "F.Cu") (net 4))
  (segment (start 43 54.92) (end 43 66) (width 0.25) (layer "F.Cu") (net 4))
  (segment (start 43 66) (end 18.73 66) (width 0.25) (layer "F.Cu") (net 4))
  (segment (start 18.73 66) (end 18.73 60) (width 0.25) (layer "F.Cu") (net 4))
  ;; SCL shared -> ADXL pad7 (99.62, 100)
  (segment (start 43 54.92) (end 43 83) (width 0.25) (layer "F.Cu") (net 4))
  (segment (start 43 83) (end 99.62 83) (width 0.25) (layer "F.Cu") (net 4))
  (segment (start 99.62 83) (end 99.62 100) (width 0.25) (layer "F.Cu") (net 4))

  ;; ── IR_OUT (net 5, width 0.25mm) ───────────────────────────
  ;; ESP32 R12 (92.7, 65.08) -> IR pad1 (77.46, 15)
  (segment (start 92.7 65.08) (end 102 65.08) (width 0.25) (layer "F.Cu") (net 5))
  (segment (start 102 65.08) (end 102 11) (width 0.25) (layer "F.Cu") (net 5))
  (segment (start 102 11) (end 77.46 11) (width 0.25) (layer "F.Cu") (net 5))
  (segment (start 77.46 11) (end 77.46 15) (width 0.25) (layer "F.Cu") (net 5))

  ;; ── RAIN_DO (net 6, width 0.25mm) ──────────────────────────
  ;; ESP32 R11 (92.7, 62.54) -> Rain Module pad3 (140, 69.27)
  (segment (start 92.7 62.54) (end 116 62.54) (width 0.25) (layer "F.Cu") (net 6))
  (segment (start 116 62.54) (end 116 69.27) (width 0.25) (layer "F.Cu") (net 6))
  (segment (start 116 69.27) (end 140 69.27) (width 0.25) (layer "F.Cu") (net 6))

  ;; ── RAIN_AO (net 7, width 0.25mm) ──────────────────────────
  ;; ESP32 R15 (92.7, 72.7) -> Rain Module pad4 (140, 71.81)
  (segment (start 92.7 72.7) (end 119 72.7) (width 0.25) (layer "F.Cu") (net 7))
  (segment (start 119 72.7) (end 119 71.81) (width 0.25) (layer "F.Cu") (net 7))
  (segment (start 119 71.81) (end 140 71.81) (width 0.25) (layer "F.Cu") (net 7))

  ;; ── ADXL_INT1 (net 8, width 0.25mm) ────────────────────────
  ;; ESP32 R9 (92.7, 57.46) -> ADXL pad4 (92, 100)
  (segment (start 92.7 57.46) (end 98 57.46) (width 0.25) (layer "F.Cu") (net 8))
  (segment (start 98 57.46) (end 98 76) (width 0.25) (layer "F.Cu") (net 8))
  (segment (start 98 76) (end 92 76) (width 0.25) (layer "F.Cu") (net 8))
  (segment (start 92 76) (end 92 100) (width 0.25) (layer "F.Cu") (net 8))

  ;; ── XSHUT (net 9, width 0.25mm) ────────────────────────────
  ;; ESP32 L13 (67.3, 67.62) -> VL53 pad5 (23.81, 60)
  (segment (start 67.3 67.62) (end 39 67.62) (width 0.25) (layer "F.Cu") (net 9))
  (segment (start 39 67.62) (end 39 69) (width 0.25) (layer "F.Cu") (net 9))
  (segment (start 39 69) (end 23.81 69) (width 0.25) (layer "F.Cu") (net 9))
  (segment (start 23.81 69) (end 23.81 60) (width 0.25) (layer "F.Cu") (net 9))

  ;; ── BUZZER_OUT (net 10, width 0.25mm) ──────────────────────
  ;; ESP32 R7 (92.7, 52.38) -> BZ1 pad1 (107.46, 20)
  (segment (start 92.7 52.38) (end 104 52.38) (width 0.25) (layer "F.Cu") (net 10))
  (segment (start 104 52.38) (end 104 20) (width 0.25) (layer "F.Cu") (net 10))
  (segment (start 104 20) (end 107.46 20) (width 0.25) (layer "F.Cu") (net 10))

  ;; ═══════════════════════════════════════════════════════════
  ;; VIAS
  ;; ═══════════════════════════════════════════════════════════
  (via (at 41 57.46) (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 3))
  (via (at 43 54.92) (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 4))
  (via (at 57 110)   (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 2))
  (via (at 100 22)   (size 0.8) (drill 0.4) (layers "F.Cu" "B.Cu") (net 1))

  ;; ═══════════════════════════════════════════════════════════
  ;; BOARD EDGE  (Edge.Cuts layer, 160mm x 120mm)
  ;; ═══════════════════════════════════════════════════════════
  (gr_rect (start 0 0) (end 160 120) (layer "Edge.Cuts") (width 0.05))

  ;; Mounting holes (M3)
  (gr_circle (center 5 5) (end 5 6.5) (layer "Edge.Cuts") (width 0.05))
  (gr_circle (center 155 5) (end 155 6.5) (layer "Edge.Cuts") (width 0.05))
  (gr_circle (center 5 115) (end 5 116.5) (layer "Edge.Cuts") (width 0.05))
  (gr_circle (center 155 115) (end 155 116.5) (layer "Edge.Cuts") (width 0.05))

  ;; ═══════════════════════════════════════════════════════════
  ;; SILKSCREEN LABELS  (F.SilkS)
  ;; ═══════════════════════════════════════════════════════════
  (gr_text "ESP32 MULTI-SENSOR BOARD" (at 80 2.5) (layer "F.SilkS")
    (effects (font (size 2 2) (thickness 0.3)) (justify center))
  )
  (gr_text "MSB-ESP32-v1.0  |  2-Layer FR4  |  1.6mm" (at 80 117) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)) (justify center))
  )
  (gr_text "I2C BUS: SDA=GPIO21  SCL=GPIO22" (at 35 73) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)) (justify center))
  )
  (gr_text "VCC=3.3V" (at 55 25) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)) (justify center))
  )
  (gr_text "DATE: 2024-04-04" (at 25 117) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)) (justify center))
  )
  (gr_text "REV: 1.0" (at 140 117) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)) (justify center))
  )

